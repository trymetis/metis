{
  "name": "metis-suite",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "e2e"
    ],
    "catalog": {
      "@aws-sdk/client-s3": "^3.1156.0",
      "@base-ui/react": "^1.9.0",
      "@bufbuild/protobuf": "^2.16.0",
      "@connectrpc/connect": "^2.2.0",
      "@connectrpc/connect-node": "^2.2.0",
      "@libsql/client": "^0.18.0",
      "@modelcontextprotocol/client": "^2.4.0",
      "@modelcontextprotocol/conformance": "0.2.0-alpha.12",
      "@playwright/test": "^1.64.1",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/bun": "^1.4.4",
      "@types/node": "^26.6.4",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "basic-ftp": "^6.2.3",
      "class-variance-authority": "^0.7.1",
      "cn": "^0.5.0",
      "electron": "^45.0.0",
      "fflate": "^0.8.3",
      "imapflow": "^2.9.1",
      "lucide-react": "^1.61.0",
      "next": "16.4.3",
      "next-themes": "^0.4.6",
      "otpauth": "^9.5.2",
      "oxfmt": "0.74.0",
      "oxlint": "1.89.0",
      "postal-mime": "^4.1.4",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "shadcn": "^4.22.1",
      "sharp": "^0.35.5",
      "sonner": "^2.0.8",
      "ssh2-sftp-client": "^12.1.1",
      "tailwindcss": "^4.3.3",
      "tw-animate-css": "^1.4.0",
      "typescript": "7.0.2",
      "vitest": "^5.0.5",
      "zod": "^4.6.5"
    }
  },
  "scripts": {
    "dev": "turbo run dev --filter=@metis/web",
    "dev:www": "turbo run dev --filter=@metis/www",
    "build": "turbo run build",
    "start": "turbo run start --filter=@metis/web",
    "lint": "oxlint --type-aware --report-unused-disable-directives && oxfmt --check",
    "lint:fix": "oxlint --type-aware --report-unused-disable-directives --fix && oxfmt",
    "typecheck": "turbo run typecheck",
    "db:push": "bun run --cwd apps/web db:push",
    "db:migrate": "bun run --cwd apps/web db:migrate",
    "db:check": "bun run --cwd apps/web db:check",
    "proto:generate": "buf generate proto --template proto/buf.gen.yaml",
    "build:desktop": "bun run --cwd apps/desktop dist",
    "dev:mobile": "bun run --cwd apps/mobile dev"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "electron",
    "sharp",
    "unrs-resolver"
  ]
}
