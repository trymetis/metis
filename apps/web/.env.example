# Full reference: https://docs.trymetis.email/self-hosting/reference/environment-variables, agent-docs/configuration.md.
# Only the first block is required. Any value can instead go in metis.config.{json,yaml,toml}; env wins per key.

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
METIS_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= # openssl rand -base64 32
METIS_OWNER_EMAIL=you@example.com # the instance owner, and the only address /setup accepts

METIS_DB_DRIVER=local # sqld | turso | local (local: never deploy it — agent-docs/database.md)
DATABASE_URL=file:./metis.db
# DATABASE_AUTH_TOKEN=
# SQLD_AUTH_JWT_KEY= # `metis sqld-auth` prints a key + token pair
MASTRA_DATABASE_URL=file:./mastra.db
# MASTRA_DATABASE_AUTH_TOKEN=

# METIS_SETUP_CODE=replace-with-a-random-setup-code
# METIS_SOURCE_URL=https://github.com/trymetis/metis # the "Source code" link on every page; running a modified version, point it at your source (AGPL §13)
# METIS_AUDIT_RETENTION_DAYS=365 # days the audit log keeps an event; env only, so the dashboard cannot shorten it

# Providers. With none, nothing can be connected until one is added in the dashboard.
#   A server entry may carry "id":"…" (letters, digits, - and _); without one its id is derived from the provider and name.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REGION=com # com | in | eu | com.au | jp
# METIS_IMAP_SERVERS=[{"name":"Fastmail","imap":{"host":"imap.fastmail.com"},"smtp":{"host":"smtp.fastmail.com"}}]
# METIS_CALDAV_SERVERS=[{"name":"Fastmail Calendar","url":"https://caldav.fastmail.com/dav/"}]
# METIS_CARDDAV_SERVERS=[{"name":"Fastmail Contacts","url":"https://carddav.fastmail.com/dav/"}]
# METIS_CLOUDFLARE_SERVERS=[{"name":"CF Mail Server 1","domain":"example.com","endpoint":"https://metis-cf-mail.you.workers.dev"}]
# METIS_RESEND_SERVERS=[{"name":"Resend Mail Server 1","domain":"example.com","endpoint":"https://metis-resend-mail.example.com"}]
# METIS_SES_SERVERS=[{"name":"SES Mail Server 1","domain":"example.com","endpoint":"https://abcdefghijklmnopqrstuvwxyz012345.lambda-url.us-east-1.on.aws"}]
# METIS_S3_SERVERS=[{"name":"Team Storage","endpoint":"https://s3.eu-central-1.amazonaws.com","region":"eu-central-1","accessKeyId":"AKIA...","secretAccessKey":"...","forcePathStyle":true}]
#   add "transfer":"relay" to an S3 entry to stream its files through the app (no bucket CORS needed, endpoint can be private)
#   add "checksums":"supported" for AWS S3 or R2 to turn on request checksums (leave it off for MinIO and most S3-compatibles)
# METIS_WEBDAV_SERVERS=[{"name":"Nextcloud","url":"https://cloud.example.com/remote.php/dav/files/"}]
# METIS_FTP_SERVERS=[{"name":"Office FTP","host":"ftp.example.com","port":21,"secure":"explicit","poolSize":2}]
#   poolSize is the total connections Metis opens to that server across all users; keep it under the server's per-IP limit
# METIS_SFTP_SERVERS=[{"name":"Office SFTP","host":"sftp.example.com","port":22,"hostKeySha256":"SHA256:..."}]
#   get hostKeySha256 with: ssh-keyscan -p 22 sftp.example.com | ssh-keygen -lf -
# METIS_DRIVE_RELAY_MAX_MB=256
# METIS_DRIVE_RELAY_CONCURRENCY=3
# METIS_DRIVE_RELAY_SECRET= # 32+ chars; required once any WebDAV, FTP, SFTP or "transfer":"relay" S3 server is listed — signs the relay's SigV4 URLs

# METIS_MAIL_IMAGE_PROXY=false # true loads remote mail images through this instance: senders do not see the viewer's IP, user agent or cookies, but still learn that and when the message was opened
# METIS_MAIL_IMAGE_PROXY_MAX_MB=10
# METIS_MAIL_CACHE_DAYS=30 # days a message body stays stored after it was last opened; a daily job clears older ones

# LLM, default disabled. OPENAI_API_KEY also serves the openai decision driver
# METIS_LLM_DRIVER=disabled # openai | anthropic | openai-compatible | disabled
# METIS_LLM_BASE_URL=https://api.example.com/v1
# METIS_LLM_API_KEY=
# METIS_LLM_CHAT_MODEL=
# METIS_LLM_SMART_REPLY_MODEL=
# METIS_LLM_CLASSIFIER_MODEL=
# METIS_LLM_SUMMARY_MODEL=
# METIS_LLM_SUMMARY_VISION=false # true when the summary model accepts images
# METIS_LLM_STRUCTURED_OUTPUTS=false # openai-compatible only; true when the endpoint supports json_schema
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# METIS_DECISION_DRIVER=disabled # systemone | openai | disabled; a driver alone turns nothing on. Every switch below also needs an LLM
# METIS_DECISION_MODEL= # jev-latest | nimble | gpt-6-luna …; required unless disabled
# METIS_DECISION_BASE_URL=https://api.typesafe.ai/v1 # systemone only
# METIS_DECISION_API_KEY= # systemone, optional (a placeholder is sent when unset). openai uses OPENAI_API_KEY
# METIS_DECISION_CLASSIFIER=false # inbox labels from the decision model
# METIS_DECISION_CLASSIFIER_BATCH=5 # 1-25; one decision call per email, this many in parallel at a time
# METIS_DECISION_SUMMARY_GATE=false # skip or narrow thread summaries
# METIS_DECISION_WORKFLOW_NODE=false # the workflow Ask and Branch steps

# METIS_PHISHING_DETECTION_DRIVER=disabled # metis | disabled
# BACKEND_URL=

# METIS_WORKFLOW_RUNNER_DRIVER=internal # internal | cron | bullmq
# CRON_SECRET= # cron: the X-Metis-Secret your scheduler sends
# METIS_WORKFLOW_REDIS_URL=redis://localhost:6379 # bullmq: the Redis the worker uses
# METIS_WORKFLOW_QUEUE_PREFIX=metis-workflows
# METIS_WORKFLOW_CADENCE_SEC=60
# METIS_WORKFLOW_TICK_BUDGET_MS=45000
# METIS_WORKFLOW_BATCH_SIZE=25
# METIS_WORKFLOW_CONCURRENCY=4
# METIS_WORKFLOW_STEP_DATA_DAYS=7 # days a finished run keeps each step's input and output; 0 clears them at once
# METIS_WORKFLOW_HISTORY_DAYS=90 # days run history is kept
# METIS_WORKFLOW_PUBLIC_URL= # HTTPS address providers and webhooks reach; enables push from Google and Microsoft
# METIS_WORKFLOW_TRUSTED_PROXIES= # comma-separated IPs or CIDR ranges whose X-Forwarded-For the webhook "Only from these IPs" check believes

# METIS_TRUSTED_PROXIES= # comma-separated IPs or CIDR ranges of proxies in front of Metis; their X-Forwarded-For hops are skipped for rate limits, sign-in limits and audit IPs

# METIS_MAIL_DRIVER=log # log | noop | resend | smtp | console
# MAIL_FROM=Metis Suite <noreply@example.com>
# MAIL_FROM_AUTH=Metis Suite <auth@example.com>
# MAIL_FROM_INVITE=Metis Suite <invites@example.com>
# RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_PLAIN=false # true lets an smtp:// or non-implicit-TLS server skip STARTTLS; only for a local relay without TLS
# CONSOLE_MAIL_URL= # console: where the instance posts its own mail (Metis Cloud)
# CONSOLE_MAIL_TOKEN= # console: this instance's bearer credential

# METIS_UPDATER_SOCKET= # the updater's Unix socket; unset hides Dashboard → System → Updates

# METIS_CACHE_DRIVER=memory # memory | redis | upstash
# METIS_CACHE_URL=redis://127.0.0.1:6379
# METIS_CACHE_TOKEN=

# METIS_TERMS_URL=https://example.com/terms
# METIS_PRIVACY_URL=https://example.com/privacy
# METIS_LEGAL_VERSION=1
# METIS_SIGNUP_DISABLED=true # false opens email/password sign-up
