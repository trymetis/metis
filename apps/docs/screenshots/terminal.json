[
  {
    "name": "self-hosting/terminal-keygen",
    "terminal": "cli-host",
    "prompt": "user@local-machine",
    "steps": [
      {
        "hidden": "ids=$(docker ps -aq); [ -z \"$ids\" ] || docker rm -f $ids > /dev/null; docker volume prune -af > /dev/null; rm -rf /opt/metis-suite /etc/metis /root/bootstrap.sh /root/backup.key /root/backup.pub; curl -fsSL \"https://sh.trymetis.email/cli/metis-linux-$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')\" -o /usr/local/bin/metis && chmod 0755 /usr/local/bin/metis"
      },
      { "type": "metis keygen --out backup" },
      { "waitForPrompt": true }
    ]
  },
  {
    "name": "self-hosting/terminal-setup",
    "terminal": "cli-host",
    "steps": [
      { "hidden": "rm -f /usr/local/bin/metis" },
      { "type": "curl -fsSL https://sh.trymetis.email/bootstrap -o bootstrap.sh" },
      { "type": "sh bootstrap.sh --version {current}" },
      { "waitFor": "Domain", "timeout": 120000 },
      { "answer": "" },
      { "answer": "owner@example.com" },
      { "waitFor": "Database" },
      { "press": "Enter" },
      { "waitFor": "Components" },
      { "press": "Enter" },
      { "waitFor": "Export key" },
      { "answer": "" },
      { "waitFor": "Google sign-in" },
      { "press": "Enter" },
      { "waitFor": "Install Metis?" },
      { "press": "y" },
      { "waitFor": "Setup code:", "timeout": 900000 },
      { "waitForPrompt": true }
    ]
  },
  {
    "name": "self-hosting/terminal-status",
    "terminal": "cli-host",
    "steps": [{ "type": "metis status" }, { "waitForPrompt": true }]
  },
  {
    "name": "self-hosting/terminal-add-worker",
    "terminal": "cli-host",
    "steps": [{ "type": "metis add worker --yes" }, { "waitForPrompt": true, "timeout": 900000 }]
  },
  {
    "name": "self-hosting/terminal-config-set",
    "terminal": "cli-host",
    "steps": [
      { "type": "metis config set METIS_SIGNUP_DISABLED=false --yes" },
      { "waitForPrompt": true, "timeout": 900000 }
    ]
  },
  {
    "name": "self-hosting/terminal-update",
    "terminal": "cli-host",
    "steps": [{ "type": "metis update" }, { "waitForPrompt": true, "timeout": 900000 }]
  },
  {
    "name": "self-hosting/terminal-undo",
    "terminal": "cli-host",
    "steps": [{ "type": "metis undo" }, { "waitForPrompt": true, "timeout": 900000 }]
  },
  {
    "name": "self-hosting/terminal-db-export",
    "terminal": "cli-host",
    "steps": [
      { "type": "metis db export --recipient backup.pub" },
      { "waitForPrompt": true, "timeout": 900000 }
    ]
  },
  {
    "name": "self-hosting/terminal-export-inspect",
    "terminal": "cli-host",
    "steps": [
      { "type": "metis export inspect /opt/metis-suite/exports/metis-export-*.tar" },
      { "waitForPrompt": true }
    ]
  },
  {
    "name": "self-hosting/terminal-maintenance",
    "terminal": "cli-host",
    "steps": [
      { "type": "metis config set METIS_MAINTENANCE=2026-11-11T10:00:00Z --yes" },
      { "waitForPrompt": true, "timeout": 900000 }
    ]
  }
]
