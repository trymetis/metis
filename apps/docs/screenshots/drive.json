[
  {
    "name": "drive/explorer-list",
    "viewport": { "width": 1440, "height": 480 },
    "path": "{workspace}/d/{drive:s3}",
    "steps": [{ "waitFor": "section[aria-label=\"Files\"] [title=\"welcome.txt\"]" }]
  },
  {
    "name": "drive/explorer-grid",
    "viewport": { "width": 1440, "height": 480 },
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"welcome.txt\"]" },
      { "click": "[aria-label=\"Switch to grid\"]" },
      { "waitFor": "[aria-label=\"Switch to list\"]" }
    ]
  },
  {
    "name": "drive/switcher",
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"welcome.txt\"]" },
      { "click": "[aria-label=\"Switch drive\"]" },
      { "waitFor": "role=menuitem[name=\"Add drive\"]" }
    ],
    "element": ["[aria-label=\"Switch drive\"]", "role=menu"]
  },
  {
    "name": "drive/sidebar",
    "clip": { "x": 0, "y": 0, "width": 760, "height": 220 },
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"Team\"]" },
      { "dblclick": "section[aria-label=\"Files\"] [title=\"Team\"]" },
      { "waitFor": "section[aria-label=\"Files\"] [title=\"website\"]" },
      { "goto": "{workspace}/d/{drive:s3}" },
      { "waitFor": "section[aria-label=\"Files\"] [title=\"welcome.txt\"]" },
      {
        "waitFor": "aside:has([aria-label=\"Switch drive\"]) >> role=button[name=\"Rebrand\"s]"
      }
    ]
  },
  {
    "name": "drive/all-drives",
    "viewport": { "width": 1440, "height": 480 },
    "path": "{workspace}/d/{drive:all}",
    "steps": [{ "waitFor": "section[aria-label=\"Files\"] button[title]" }]
  },
  {
    "name": "drive/all-drives-picker",
    "path": "{workspace}/d/{drive:all}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] button[title]" },
      { "click": "role=button[name=\"New folder\"s]" },
      { "waitFor": "role=dialog >> text=Choose the folder to create it in." },
      { "wait": 800 }
    ],
    "element": "role=dialog"
  },
  {
    "name": "drive/search",
    "viewport": { "width": 1440, "height": 480 },
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"Clients\"]" },
      {
        "fill": "input[placeholder=\"Search this drive\"]",
        "value": "welcome"
      },
      { "wait": 2000 },
      { "waitFor": "section[aria-label=\"Files\"] [title=\"welcome.txt\"]" }
    ]
  },
  {
    "name": "drive/new-folder-dialog",
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"welcome.txt\"]" },
      { "click": "role=button[name=\"New folder\"s]" },
      { "waitFor": "role=dialog[name=\"New folder\"]" }
    ],
    "element": "role=dialog"
  },
  {
    "name": "drive/file-menu",
    "viewport": { "width": 1024, "height": 440 },
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"welcome.txt\"]" },
      { "click": "[aria-label=\"Actions for welcome.txt\"]" },
      { "waitFor": "role=menuitem[name=\"Download\"]" }
    ]
  },
  {
    "name": "drive/folder-menu",
    "viewport": { "width": 1024, "height": 440 },
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"Clients\"]" },
      { "click": "[aria-label=\"Actions for Clients\"]" },
      { "waitFor": "role=menuitem[name=\"Pin to sidebar\"]" }
    ]
  },
  {
    "name": "drive/rename-dialog",
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"welcome.txt\"]" },
      { "click": "[aria-label=\"Actions for welcome.txt\"]" },
      { "click": "role=menuitem[name=\"Rename\"s]" },
      { "waitFor": "role=dialog[name=\"Rename\"]" }
    ],
    "element": "role=dialog"
  },
  {
    "name": "drive/delete-dialog",
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"welcome.txt\"]" },
      { "click": "[aria-label=\"Actions for welcome.txt\"]" },
      { "click": "role=menuitem[name=\"Delete\"s]" },
      { "waitFor": "role=alertdialog[name=\"Delete welcome.txt?\"]" }
    ],
    "element": "role=alertdialog"
  },
  {
    "name": "drive/preview-pdf",
    "viewport": { "width": 1440, "height": 420 },
    "element": "aside[aria-label=\"Preview of moodboard.pdf\"]",
    "path": "{workspace}/d/{drive:s3}/Clients%2FAozora%20Ceramics%2FRebrand%2F",
    "steps": [
      {
        "waitFor": "section[aria-label=\"Files\"] [title=\"moodboard.pdf\"]"
      },
      {
        "dblclick": "section[aria-label=\"Files\"] [title=\"moodboard.pdf\"]"
      },
      {
        "waitFor": "aside[aria-label=\"Preview of moodboard.pdf\"] [aria-label=\"Next page\"]:not([disabled])"
      },
      { "wait": 2000 }
    ]
  },
  {
    "name": "drive/preview-table",
    "viewport": { "width": 1920, "height": 640 },
    "element": "aside[aria-label=\"Preview of invoices.csv\"]",
    "path": "{workspace}/d/{drive:s3}/Finance%2F2025%2F",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"invoices.csv\"]" },
      { "dblclick": "section[aria-label=\"Files\"] [title=\"invoices.csv\"]" },
      { "waitFor": "aside[aria-label=\"Preview of invoices.csv\"] table" },
      { "wait": 800 }
    ]
  },
  {
    "name": "drive/preview-fallback",
    "viewport": { "width": 1440, "height": 480 },
    "path": "{workspace}/d/{drive:s3}/Clients%2FKaltwasser%20GmbH%2F",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"Pitch deck.pptx\"]" },
      { "dblclick": "section[aria-label=\"Files\"] [title=\"Pitch deck.pptx\"]" },
      {
        "waitFor": "aside[aria-label=\"Preview of Pitch deck.pptx\"] >> text=There is no preview for this file type."
      }
    ],
    "element": "aside[aria-label=\"Preview of Pitch deck.pptx\"]"
  },
  {
    "name": "drive/restricted-drive",
    "viewport": { "width": 1440, "height": 480 },
    "path": "{workspace}/d/{drive:ftp}",
    "steps": [{ "waitFor": "section[aria-label=\"Files\"] [title=\"Clients\"]" }]
  },
  {
    "name": "drive/folder-restriction-settings",
    "path": "{workspace}/settings/drives",
    "steps": [
      { "waitFor": "[aria-label=\"Choose folders\"]" },
      { "click": "[aria-label=\"Choose folders\"]" },
      { "waitFor": "text=Pick the top-level folders this workspace can see." },
      { "waitFor": "role=button[name=\"Save\"s]" },
      { "wait": 500 }
    ]
  },
  {
    "name": "drive/add-drive-dialog",
    "path": "{workspace}/settings/drives",
    "steps": [
      { "waitFor": "role=button[name=\"Add drive\"s]" },
      { "click": "role=button[name=\"Add drive\"s]" },
      { "waitFor": "role=dialog[name=\"Add a drive\"]" },
      { "wait": 500 }
    ],
    "element": "role=dialog"
  },
  {
    "name": "drive/drive-ai",
    "viewport": { "width": 1440, "height": 560 },
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"welcome.txt\"]" },
      { "click": "role=button[name=\"Drive AI\"s]" },
      { "waitFor": "text=Ask about these files" },
      { "wait": 500 }
    ]
  },
  {
    "name": "drive/shortcuts-help",
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"welcome.txt\"]" },
      { "press": "?" },
      { "waitFor": "role=dialog >> text=Keyboard shortcuts" },
      { "click": "role=dialog >> role=heading[name=\"Keyboard shortcuts\"]" }
    ],
    "element": "role=dialog"
  },
  {
    "name": "drive/recent-folders",
    "clip": { "x": 0, "y": 0, "width": 760, "height": 240 },
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"Clients\"]" },
      { "dblclick": "section[aria-label=\"Files\"] [title=\"Clients\"]" },
      { "waitFor": "section[aria-label=\"Files\"] [title=\"Aozora Ceramics\"]" },
      { "dblclick": "section[aria-label=\"Files\"] [title=\"Aozora Ceramics\"]" },
      {
        "waitFor": "section[aria-label=\"Files\"] [title=\"Rebrand\"]"
      },
      { "waitFor": "aside:has([aria-label=\"Switch drive\"]) >> text=Recent" }
    ]
  },
  {
    "name": "drive/preview-zip",
    "path": "{workspace}/d/{drive:s3}/Clients%2FAozora%20Ceramics%2FRebrand%2F",
    "steps": [
      { "waitFor": "section[aria-label=\"Files\"] [title=\"logo-pack.zip\"]" },
      { "dblclick": "section[aria-label=\"Files\"] [title=\"logo-pack.zip\"]" },
      {
        "waitFor": "aside[aria-label=\"Preview of logo-pack.zip\"] >> text=README.txt"
      }
    ],
    "element": "aside[aria-label=\"Preview of logo-pack.zip\"]"
  }
]
