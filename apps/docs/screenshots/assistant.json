[
  {
    "name": "assistant/workspace-ai-empty",
    "path": "{workspace}/assistant",
    "steps": [
      { "waitFor": "text=\"Ask across your whole workspace\"" },
      {
        "waitFor": "role=button[name=\"Find the latest contract in my drives\"s]"
      }
    ]
  },
  {
    "name": "assistant/reference-picker",
    "path": "{workspace}/assistant",
    "steps": [
      { "waitFor": "role=textbox[name=\"Ask across your workspace\"s]" },
      { "click": "role=textbox[name=\"Ask across your workspace\"s]" },
      { "press": "@" },
      { "waitFor": "role=listbox[name=\"Insert a reference\"] >> role=option" },
      { "press": "b" },
      { "press": "r" },
      { "press": "i" },
      { "press": "e" },
      { "press": "f" },
      {
        "waitFor": "role=listbox[name=\"Insert a reference\"] >> role=option[name=/brief\\.md/]"
      },
      { "wait": 600 }
    ],
    "element": [
      "[role=dialog]:has([aria-label=\"Insert a reference\"])",
      "form:has([aria-label=\"Ask across your workspace\"])"
    ]
  },
  {
    "name": "assistant/stored-conversation",
    "path": "{workspace}/assistant",
    "steps": [
      { "waitFor": "role=complementary >> role=listitem >> role=link" },
      { "click": "role=complementary >> role=listitem >> role=link", "nth": 0 },
      {
        "waitFor": "role=log >> text=\"What needs my attention across my mailboxes this week?\""
      },
      { "wait": 800 }
    ]
  },
  {
    "name": "assistant/mail-ai-panel",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      { "waitFor": "role=main >> role=button[name=\"Toggle AI agent\"]" },
      { "click": "role=main >> role=button[name=\"Toggle AI agent\"]" },
      { "waitFor": "role=textbox[name=\"Ask about your emails…\"]" },
      { "click": "role=button[name=\"Attach an email\"]" },
      {
        "waitFor": "role=listbox[name=\"Suggestions\"] >> role=option >> text=\"Rebrand kickoff\""
      },
      {
        "click": "role=listbox[name=\"Suggestions\"] >> role=option >> text=\"Rebrand kickoff\""
      },
      { "press": "Escape" },
      { "wait": 400 },
      { "click": "role=heading[level=1][name=\"Inbox\"]" },
      { "waitFor": "text=/^1 attached$/" },
      { "wait": 400 }
    ]
  },
  {
    "name": "assistant/calendar-ai-panel",
    "path": "{workspace}/c/{calendar}",
    "seededWeek": true,
    "steps": [
      {
        "waitFor": "role=banner >> role=button[name=/^(Day|Week|Month|Year|Schedule)$/]"
      },
      {
        "click": "role=banner >> role=button[name=/^(Day|Week|Month|Year|Schedule)$/]"
      },
      { "click": "role=menuitem[name=/^Week/]" },
      { "waitFor": "role=button[name=/^Design review/]" },
      { "click": "role=banner >> role=button[name=\"Calendar AI\"s]" },
      { "waitFor": "role=textbox[name=\"Ask about your calendar…\"]" },
      { "wait": 400 }
    ]
  },
  {
    "name": "assistant/drive-ai-panel",
    "path": "{workspace}/d/{drive:s3}",
    "steps": [
      { "waitFor": "role=navigation[name=\"breadcrumb\"]" },
      { "click": "role=button[name=\"Drive AI\"s]" },
      { "waitFor": "role=textbox[name=\"Ask about these files…\"]" },
      { "wait": 400 }
    ]
  },
  {
    "name": "assistant/mcp-clients",
    "viewport": { "width": 1440, "height": 562 },
    "path": "/settings/mcp",
    "steps": [
      { "waitFor": "role=heading[name=\"MCP clients\"s]" },
      { "waitFor": "role=button[name=\"Add client\"s]" }
    ]
  },
  {
    "name": "assistant/add-mcp-client",
    "path": "/settings/mcp",
    "element": "role=dialog",
    "steps": [
      { "waitFor": "role=button[name=\"Add client\"s]" },
      { "click": "role=button[name=\"Add client\"s]" },
      { "waitFor": "role=dialog >> text=\"Add an MCP client\"" },
      { "waitFor": "role=dialog >> text=\"Sign-in port\"" },
      { "wait": 300 }
    ]
  },
  {
    "name": "assistant/mcp-client-page",
    "viewport": { "width": 1440, "height": 720 },
    "path": "/settings/mcp",
    "steps": [
      { "waitFor": "role=link[name=\"Open Tandem\"]" },
      { "click": "role=link[name=\"Open Tandem\"]" },
      { "waitFor": "role=heading[level=1][name=\"Tandem\"]" },
      { "waitFor": "main >> text=Client ID:" },
      { "wait": 400 }
    ]
  },
  {
    "name": "assistant/mcp-client-workspaces",
    "path": "/settings/mcp",
    "steps": [
      { "click": "role=link[name=\"Open Tandem\"]" },
      { "waitFor": "section:has(> h2:text-is(\"Workspaces\")) >> role=switch" },
      { "scroll": "section:has(> h2:text-is(\"Workspaces\"))" }
    ],
    "element": "section:has(> h2:text-is(\"Workspaces\"))"
  },
  {
    "name": "assistant/remove-mcp-client",
    "path": "/settings/mcp",
    "steps": [
      { "click": "role=link[name=\"Open Tandem\"]" },
      { "waitFor": "role=heading[level=1][name=\"Tandem\"]" },
      { "click": "main >> role=button[name=\"Remove client\"]" },
      { "waitFor": "role=alertdialog >> text=Also remove it locally" },
      { "wait": 300 }
    ],
    "element": "role=alertdialog"
  },
  {
    "name": "assistant/approval-card",
    "element": ["text=/^Operating across/", "role=log"],
    "path": "{workspace}/assistant",
    "steps": [
      { "waitFor": "role=textbox[name=\"Ask across your workspace\"s]" },
      {
        "fill": "role=textbox[name=\"Ask across your workspace\"s]",
        "value": "Make a folder called Final artwork in Team on my WebDAV drive."
      },
      { "press": "Enter" },
      { "waitFor": "role=log >> role=button[name=\"Approve\"s]" },
      { "wait": 600 }
    ]
  }
]
