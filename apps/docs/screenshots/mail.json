  {
    "name": "mail/shortcuts-help",
    "element": "role=dialog[name=\"Keyboard shortcuts\"]",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "waitFor": "main [aria-roledescription=\"draggable\"]"
      },
      {
        "click": "role=heading[level=1][name=\"Inbox\"]"
      },
      {
        "wait": 500
      },
      {
        "press": "?"
      },
      {
        "waitFor": "role=heading[level=2][name=\"Keyboard shortcuts\"]"
      },
      {
        "click": "role=dialog[name=\"Keyboard shortcuts\"] >> role=heading[level=2]"
      }
    ]
  },
  {
    "name": "mail/read-later",
    "element": "div:has(> div > div > h1:text-is(\"Read later\"))",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      { "clearReadLater": true },
      { "goto": "{workspace}/m/{mailbox}/inbox" },
      { "click": "role=tab[name=/^All$/]" },
      {
        "click": "main [aria-roledescription=\"draggable\"] >> text=\"Your order A-42 has shipped\""
      },
      { "waitFor": "main h2:has-text(\"Your order A-42 has shipped\")" },
      {
        "click": "div:has(> button[title=\"Previous message\"]) >> role=button[name=\"Read later\"]"
      },
      {
        "waitFor": "div:has(> button[title=\"Previous message\"]) >> role=button[name=\"Saved\"]"
      },
      { "wait": 800 },
      { "goto": "{workspace}/m/{mailbox}/read-later" },
      { "waitFor": "role=heading[level=1][name=\"Read later\"]" },
      {
        "waitFor": "main [aria-roledescription=\"draggable\"] >> text=\"Your order A-42 has shipped\""
      }
    ]
  },
  {
    "name": "mail/switch-mailbox",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      { "click": "role=button[name=/^Switch mailbox$/]" },
      { "waitFor": "role=menuitem[name=/Manage mailboxes/]" }
    ],
    "element": ["role=button[name=/^Switch mailbox$/]", "role=menu"]
  }
]
