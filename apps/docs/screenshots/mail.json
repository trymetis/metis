        "click": "main [aria-roledescription=\"draggable\"] >> text=\"Rebrand kickoff\""
      },
      {
        "waitFor": "main h2:has-text(\"Rebrand kickoff\")"
      },
      {
        "click": "role=button[name=\"More actions\"]"
      },
      {
        "click": "role=menuitem[name=\"Draft apology\"]"
      },
      {
        "fill": "#apology-situation",
        "value": "missed our call yesterday"
      },
      {
        "click": "role=alertdialog >> role=heading[name=\"Draft an apology\"]"
      }
    ],
    "element": "role=alertdialog"
