[
  {
    "name": "mail/inbox",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "click": "role=tab[name=/^All$/]"
      },
      {
        "click": "main [aria-roledescription=\"draggable\"] >> text=\"Rebrand kickoff\""
      },
      {
        "waitFor": "main h2:has-text(\"Rebrand kickoff\")"
      },
      {
        "waitFor": "text=TL;DR"
      }
    ]
  },
  {
    "name": "mail/folders-sidebar",
    "clip": { "x": 0, "y": 0, "width": 640, "height": 900 },
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "waitFor": "role=complementary[name=\"Folders\"]"
      }
    ]
  },
  {
    "name": "mail/save-to-drive",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "click": "role=tab[name=/^All$/]"
      },
      {
        "click": "main [aria-roledescription=\"draggable\"] >> text=/^Invitation: Rebrand review/"
      },
      {
        "waitFor": "main h2:has-text(\"Invitation: Rebrand review\")"
      },
      {
        "click": "role=button[name=\"Save invite.ics to a drive\"]"
      },
      {
        "waitFor": "role=dialog[name=\"Save to Drive\"] >> role=button[name=/ · /]"
      }
    ],
    "element": "role=dialog[name=\"Save to Drive\"]"
  },
  {
    "name": "mail/search-results",
    "viewport": { "width": 1440, "height": 320 },
    "element": "div:has(> div > div > h1:text-is(\"Inbox\"))",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "click": "role=tab[name=/^All$/]"
      },
      {
        "fill": "role=textbox[name=\"Search emails\"]",
        "value": "A-42"
      },
      {
        "press": "Enter"
      },
      {
        "waitFor": "main [aria-roledescription=\"draggable\"] >> text=\"Your order A-42 has shipped\""
      },
      {
        "click": "role=heading[level=1][name=\"Inbox\"]"
      },
      {
        "wait": 800
      }
    ]
  },
  {
    "name": "mail/change-label-menu",
    "viewport": { "width": 1440, "height": 440 },
    "element": "div:has(> div > button[title=\"Previous message\"])",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "click": "role=tab[name=/^All$/]"
      },
      {
        "click": "main [aria-roledescription=\"draggable\"] >> text=\"Rebrand kickoff\""
      },
      {
        "waitFor": "main h2:has-text(\"Rebrand kickoff\")"
      },
      {
        "click": "div:has(> button[title=\"Previous message\"]) >> role=button[name=\"Change label\"]"
      },
      {
        "waitFor": "role=menu[name=\"Change label\"]"
      }
    ]
  },
  {
    "name": "mail/add-label",
    "viewport": { "width": 1440, "height": 1040 },
    "clip": { "x": 0, "y": 520, "width": 300, "height": 520 },
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "click": "role=complementary[name=\"Folders\"] >> role=button[name=\"Add custom label\"]"
      },
      {
        "fill": "role=complementary[name=\"Folders\"] >> role=textbox[name=\"Label name\"]",
        "value": "Invoices"
      }
    ]
  },
  {
    "name": "mail/composer",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "click": "role=complementary[name=\"Folders\"] >> role=button[name=/^Compose$/]"
      },
      {
        "waitFor": "[aria-modal=\"true\"]:has([aria-label=\"Close compose\"])"
      },
      {
        "fill": "role=combobox[name=\"To recipients\"]",
        "value": "kenji@aozora-ceramics.jp"
      },
      {
        "waitFor": "role=option[name=/kenji@aozora-ceramics\\.jp/]"
      },
      {
        "press": "ArrowDown"
      },
      {
        "press": "Enter"
      },
      {
        "fill": "role=textbox[name=\"Subject line…\"]",
        "value": "Packaging mockups"
      },
      {
        "fill": "[aria-modal=\"true\"]:has([aria-label=\"Close compose\"]) [contenteditable=\"true\"]",
        "value": "Hi Kenji, here are the packaging mockups we talked about."
      },
      {
        "click": "[aria-modal=\"true\"]:has([aria-label=\"Close compose\"]) >> role=button[name=/^Cc$/]"
      },
      {
        "waitFor": "role=combobox[name=\"Cc recipients\"]"
      }
    ],
    "element": "[aria-modal=\"true\"]:has([aria-label=\"Close compose\"])"
  },
  {
    "name": "mail/reply-footer",
    "element": "div:has(> div > button[title=\"Previous message\"])",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "click": "role=tab[name=/^All$/]"
      },
      {
        "click": "main [aria-roledescription=\"draggable\"] >> text=\"Rebrand kickoff\""
      },
      {
        "waitFor": "main h2:has-text(\"Rebrand kickoff\")"
      },
      {
        "click": "role=button[name=\"Reply 3 smart replies\"]"
      },
      {
        "waitFor": "role=textbox[name=\"Reply text\"]"
      },
      {
        "wait": 600
      }
    ]
  },
  {
    "name": "mail/schedule-menu",
