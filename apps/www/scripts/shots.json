    "name": "mcp/control",
    "from": "assistant/mcp-clients",
    "steps": [
      { "waitFor": "role=link[name=\"Open Claude Code\"s]" },
      { "click": "role=link[name=\"Open Claude Code\"s]" },
      { "waitFor": "role=heading[level=1][name=\"Claude Code\"s]" },
      { "wait": 400 }
    ],
    "focus": [
      "main h1",
      "main >> text=Client ID:",
      "main >> role=switch[name=/enabled$/]",
      "main >> role=button[name=\"Remove client\"]"
    ]
  },
  {
    "name": "mcp/no-secret",
    "from": "assistant/add-mcp-client",
    "steps": [
      {
        "fill": "role=dialog >> input[placeholder=\"Claude Code — laptop\"]",
        "value": "Claude Code — laptop"
      },
      {
        "click": "role=dialog >> role=button[name=\"Add client\"s]"
      },
      {
        "waitFor": "role=dialog >> text=Client ID"
      },
      {
        "wait": 500
      }
    ]
  },
  {
    "name": "mcp/sign-ins",
    "from": "assistant/mcp-clients",
    "steps": [
      { "waitFor": "role=link[name=\"Open Claude Code\"s]" },
      { "click": "role=link[name=\"Open Claude Code\"s]" },
      { "waitFor": "role=heading[level=1][name=\"Claude Code\"s]" },
