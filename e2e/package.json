{
  "name": "@metis/e2e",
  "private": true,
  "type": "module",
  "exports": {
    "./lib/*": "./lib/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "up": "docker compose --env-file .env.fixture up --build --wait app proxy cron worker srh",
    "down": "docker compose --env-file .env.fixture down --volumes --remove-orphans",
    "generate": "bun run --cwd ../apps/web e2e:generate",
    "generate:record": "bun run --cwd ../apps/web e2e:generate:record",
    "test": "bun run down && bun run up && bun run test:browser && bun run test:api",
    "test:api": "NODE_EXTRA_CA_CERTS=tls/ca.crt node --env-file=.env.fixture node_modules/vitest/vitest.mjs run",
    "test:browser": "node --env-file=.env.fixture node_modules/@playwright/test/cli.js test",
    "test:browser:ui": "node --env-file=.env.fixture node_modules/@playwright/test/cli.js test --ui",
    "test:desktop": "node --env-file=.env.fixture node_modules/@playwright/test/cli.js test --config desktop.config.ts",
    "totp": "curl -s http://localhost:8099/totp",
    "logs": "docker compose --env-file .env.fixture logs -f seed replay app",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@libsql/client": "catalog:",
    "basic-ftp": "catalog:",
    "fflate": "catalog:",
    "imapflow": "catalog:",
    "otpauth": "catalog:",
    "ssh2-sftp-client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/conformance": "catalog:",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/ssh2-sftp-client": "^9.0.6",
    "electron": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
