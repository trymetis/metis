[
  {
    "name": "mail/inbox",
    "target": "all",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "click": "role=tab[name=/^All$/]"
      },
      {
        "click": "main [aria-roledescription=\"draggable\"] >> text=\"Rebrand kickoff\""
      },
      {
        "waitFor": "main h2:has-text(\"Rebrand kickoff\")"
      },
      {
        "click": "main >> role=button[name=\"Show summary cards\"]"
      },
      {
        "waitFor": "text=TL;DR"
      }
    ],
    "www": [
      {
        "name": "mail/all-inboxes",
        "focus": "div:has(> div > div > h1:text-is(\"Inbox\"))"
      },
      {
        "name": "mail/summary",
        "focus": "text=TL;DR >> xpath=../.."
      },
      {
        "name": "screens/inbox",
        "focus": null
      }
    ]
  },
