  {
    "name": "mail/shortcuts-help",
    "target": "all",
    "element": "role=dialog[name=\"Keyboard shortcuts\"]",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "waitFor": "main [aria-roledescription=\"draggable\"]"
      },
      {
        "click": "role=heading[level=1][name=\"Inbox\"]"
      },
      {
        "wait": 500
      },
      {
        "press": "?"
      },
      {
        "waitFor": "role=heading[level=2][name=\"Keyboard shortcuts\"]"
      },
      {
        "click": "role=dialog[name=\"Keyboard shortcuts\"] >> role=heading[level=2]"
      }
    ],
    "www": [
      {
        "name": "mail/shortcuts"
      }
    ]
  },
  {
    "name": "mail/read-later",
    "target": "all",
    "element": "div:has(> div > div > h1:text-is(\"Read later\"))",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "clearReadLater": true
      },
      {
        "goto": "{workspace}/m/{mailbox}/inbox"
      },
      {
        "click": "role=tab[name=/^All$/]"
      },
      {
        "click": "main [aria-roledescription=\"draggable\"] >> text=\"Your order A-42 has shipped\""
      },
      {
        "waitFor": "main h2:has-text(\"Your order A-42 has shipped\")"
      },
      {
        "click": "[role=\"toolbar\"][aria-label=\"Message actions\"] >> role=button[name=\"Read later\"]"
      },
      {
        "waitFor": "[role=\"toolbar\"][aria-label=\"Message actions\"] >> role=button[name=\"Saved\"]"
      },
      {
        "wait": 800
      },
      {
        "goto": "{workspace}/m/{mailbox}/read-later"
      },
      {
        "waitFor": "role=heading[level=1][name=\"Read later\"]"
      },
      {
        "waitFor": "main [aria-roledescription=\"draggable\"] >> text=\"Your order A-42 has shipped\""
      }
    ],
    "www": [
      {
        "name": "mail/read-later"
      }
    ]
  },
  {
    "name": "mail/switch-mailbox",
    "target": "docs",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "click": "role=button[name=/^Switch mailbox$/]"
      },
      {
        "waitFor": "role=menuitem[name=/Manage mailboxes/]"
      }
    ],
    "element": ["role=button[name=/^Switch mailbox$/]", "role=menu"]
  },
  {
    "name": "mail/signatures-page",
    "target": "docs",
    "path": "{workspace}/settings/signatures",
    "steps": [
      {
        "click": "role=region[name=/^Signatures for ana@/] >> role=button[name=/^ana@/]"
      },
      {
        "click": "role=region[name=/^Signatures for ana@/] >> role=region[name=\"Your signatures\"] >> role=button[name=\"Add\"]"
      },
      {
        "waitFor": "role=dialog[name=\"New signature\"]"
      },
      {
        "fill": "role=dialog >> role=textbox[name=\"Signature name\"]",
        "value": "Work"
      },
      {
        "click": "role=dialog >> role=button[name=\"HTML\"]"
      },
      {
        "fill": "role=dialog >> role=textbox[name=\"Signature HTML\"]",
        "value": "<p><strong>{{name}}</strong><br>Studio lead, Fernhill Studio<br><a href=\"mailto:{{email}}\">{{email}}</a></p>"
      },
      {
        "click": "role=dialog >> role=checkbox[name=\"Default for new messages\"]"
      },
      {
        "click": "role=dialog >> role=checkbox[name=\"Default for replies and forwards\"]"
      },
      {
        "click": "role=dialog >> role=button[name=\"Save\"]"
      },
      {
        "waitForHidden": "role=dialog[name=\"New signature\"]"
      },
      {
        "waitFor": "role=region[name=/^Signatures for ana@/] >> role=region[name=\"Your signatures\"] >> text=\"New messages\""
      }
    ]
  },
  {
    "name": "mail/signatures-editor",
    "target": "docs",
    "path": "{workspace}/settings/signatures",
    "steps": [
      {
        "click": "role=region[name=/^Signatures for ana@/] >> role=button[name=/^ana@/]"
      },
      {
        "click": "role=button[name=\"Edit Work\"]"
      },
      {
        "waitFor": "role=dialog[name=\"Edit signature\"] >> text=\"Preview\""
      },
      {
        "click": "role=dialog >> role=button[name=\"HTML\"]"
      },
      {
        "wait": 400
      }
    ],
    "element": "role=dialog[name=\"Edit signature\"]"
  },
  {
    "name": "mail/signatures-footer",
    "target": "docs",
    "path": "{workspace}/settings/signatures",
    "steps": [
      {
        "click": "role=region[name=\"Footer\"] >> role=button[name=\"Edit\"]"
      },
      {
        "waitFor": "role=dialog[name=\"Mail footer\"]"
      },
      {
        "click": "role=dialog >> role=button[name=\"HTML\"]"
      },
      {
        "fill": "role=dialog >> role=textbox[name=\"Signature HTML\"]",
        "value": "<p style=\"color:#6b7280;font-size:12px\">Fernhill Studio Ltd. This message and any files sent with it are confidential.</p>"
      },
      {
        "click": "role=dialog >> role=button[name=\"Save\"]"
      },
      {
        "waitForHidden": "role=dialog[name=\"Mail footer\"]"
      },
      {
        "waitFor": "role=region[name=\"Footer\"] >> text=/confidential/"
      }
    ],
    "element": "role=region[name=\"Footer\"]"
  },
  {
    "name": "mail/signatures-picker",
    "target": "docs",
    "path": "{workspace}/m/{mailbox}/inbox",
    "steps": [
      {
        "click": "role=complementary[name=\"Folders\"] >> role=button[name=/^Compose$/]"
      },
      {
        "waitFor": "[role=\"dialog\"]:has([aria-label=\"Close compose\"]) [data-metis-signature]"
      },
      {
        "click": "[role=\"dialog\"]:has([aria-label=\"Close compose\"]) >> role=button[name=\"Signature\"]"
      },
      {
        "waitFor": "role=menuitem[name=\"No signature\"]"
      }
    ],
    "element": ["[role=\"dialog\"]:has([aria-label=\"Close compose\"])", "role=menu"]
  }
]
